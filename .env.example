# Contoh variabel — SALIN ke .env untuk pengembangan lokal.
# .env WAJIB masuk .gitignore. Rahasia produksi TIDAK PERNAH di sini —
# semuanya di panel Environment Dokploy (docs/50-operations/CONFIGURATION.md,
# fondasi-server-ionowu.md CFG-03).

# ── Dev lokal: dibaca docker-compose.dev.yml lewat interpolasi ${VAR} ──
# Nilai-nilai ini TIDAK lagi ditulis langsung di docker-compose.dev.yml
# (berkas itu publik) — harus ada di .env (gitignored) supaya
# `docker compose up` jalan. Generate milikmu sendiri, jangan pakai nilai
# siapa pun yang pernah ter-commit di riwayat repo ini:
#   DEV_POSTGRES_PASSWORD : bebas, string acak apa pun (openssl rand -hex 16)
#   DEV_JWT_PUBLIC_KEY / DEV_JWT_PRIVATE_KEY : pasangan Ed25519 base64 standar
#     (lihat internal/config/config.go — 32 byte publik, 64 byte privat)
DEV_POSTGRES_PASSWORD=
DEV_JWT_PUBLIC_KEY=
DEV_JWT_PRIVATE_KEY=

# DATABASE_URL polos dipakai `goose` (tooling migrasi generik). Aplikasi Go
# sendiri membaca IONOWU_SWEET_DATABASE_URL (CFG-06) — nilainya sama di dev.
DATABASE_URL=postgres://ionowu:${DEV_POSTGRES_PASSWORD}@postgres:5432/ionowu_dev?sslmode=disable
IONOWU_SWEET_DATABASE_URL=postgres://ionowu:${DEV_POSTGRES_PASSWORD}@postgres:5432/ionowu_dev?sslmode=disable
REDIS_URL=redis://redis:6379
ENVIRONMENT=development
LOG_LEVEL=debug

# ── Produksi: WAJIB diisi sendiri, JANGAN PERNAH commit nilainya ─────
# Pasangan berbeda dari DEV_JWT_* di atas — kunci produksi tidak boleh sama
# dengan kunci yang sudah pernah ada di riwayat git repo publik ini.
IONOWU_SWEET_JWT_PRIVATE_KEY=
IONOWU_SWEET_JWT_PUBLIC_KEY=

# CORS — daftar origin apps/web dipisah koma. Wajib: pos-engine gagal start
# tanpa ini (fail-fast, CFG-05). web dan pos-engine SELALU beda origin
# (beda port di dev, beda domain di produksi — DOKPLOY.md §4).
IONOWU_SWEET_CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# ── Belum dibaca kode apa pun — jangan wired sampai fitur terkait digarap.
# Dipertahankan di sini sebagai pengingat kebutuhan yang sudah diketahui
# (FR-23 QRIS, FR-50/51 WhatsApp), BUKAN konfigurasi aktif. Lihat
# docs/CLAUDE.md "Yang memblokir, dan bukan pekerjaan teknis".
# QRIS_API_KEY=
# QRIS_WEBHOOK_SECRET=
# WHATSAPP_API_TOKEN=
# CS_SUPPORT_EMAIL=warungwangi@ionowu.com

# ── Produksi saja (diisi di panel Environment Dokploy, bukan di sini) ─
# IMAGE_TAG=<sha commit>
# POSTGRES_SUPERUSER_PASSWORD=   # docker-compose.data.yml
# SWEET_APP_PASSWORD=            # docker-compose.data.yml, infra/initdb/10-sweet.sh
# REDIS_PASSWORD=                # docker-compose.data.yml
# GHCR_TOKEN=
# GRAFANA_CLOUD_API_KEY=
# SENTRY_DSN=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
