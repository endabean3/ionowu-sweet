# Contoh variabel — SALIN ke .env untuk pengembangan lokal.
# .env WAJIB masuk .gitignore. Rahasia produksi TIDAK PERNAH di sini —
# semuanya di panel Environment Dokploy (50-operations/CONFIGURATION.md).

# ── Dev lokal: nilai di bawah aman, bukan rahasia ────────────────────
DATABASE_URL=postgres://ionowu:devpass@postgres:5432/ionowu_dev?sslmode=disable
REDIS_URL=redis://redis:6379
ENVIRONMENT=development
LOG_LEVEL=debug

# ── Wajib diisi sendiri (jangan pernah commit nilainya) ──────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SESSION_SECRET=

# ── Menunggu keputusan vendor ────────────────────────────────────────
QRIS_API_KEY=
QRIS_WEBHOOK_SECRET=
WHATSAPP_API_TOKEN=

# ── Produksi saja (diisi di Dokploy, bukan di sini) ──────────────────
# GH_REPO=endabean3/docs-umkm-intelligence
# IMAGE_TAG=<sha commit>
# DATABASE_URL_READONLY=
# GHCR_TOKEN=
# GRAFANA_CLOUD_API_KEY=
# SENTRY_DSN=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
